<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<!--
  Pubblica un eseguibile autonomo per Windows 64 bit in una sottocartella.

  ATTENZIONE: questo profilo puntava alla radice del progetto con
  DeleteExistingFiles=true, cioe' una pubblicazione avrebbe riversato ~400 file
  fra i sorgenti dopo averne cancellati. Il PublishUrl deve restare una
  sottocartella dedicata, che e' anche quella esclusa in .gitignore.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>publish-win-x64-self-contained</PublishUrl>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <SiteUrlToLaunchAfterPublish />
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
