<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>

    <!-- La navigazione fuori da un contesto interattivo non deve sollevare eccezioni. -->
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>

    <!-- La cartella di pubblicazione sta dentro al progetto: non va trattata come sorgente. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish-win-x64-self-contained\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- I temi di parole devono stare accanto all'eseguibile, sia in compilazione sia in
       pubblicazione: WordLibrary li cerca in ContentRootPath/temi. -->
  <ItemGroup>
    <Content Include="temi\**\*.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Serve al codice QR che apre il telecomando sul telefono. -->
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>
